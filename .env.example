OPENROUTER_API_KEY=your_openrouter_key_here

# --- web UI / server ---
# Team logins are accounts in the database: python3 manage.py adduser NAME   (no password in this file)
# UI_REQUIRE_LOGIN=1                      # set by the systemd unit: the app refuses to start until a user exists
# UI_HOST=127.0.0.1                       # keep it on loopback and put Caddy/nginx in front
# UI_PORT=8765
# DATA_DIR=/opt/transcript                # downloads/, outputs/ and data/app.db live here (default: the repo folder)
# SESSION_SECRET=                         # optional; generated into data/.session_secret if empty
# KEEP_AUDIO=0                            # 0 = delete the mp3 after each job (saves disk for hundreds of episodes)
# YT_COOKIES=/opt/transcript/cookies.txt  # export from a logged-in browser if YouTube blocks the server ("confirm you're not a bot")
# YT_PROXY=                               # optional proxy for yt-dlp

# --- speaker labelling ---
# DIARIZER=fast                           # fast = sherpa-onnx (default when installed), pyannote = slower, more accurate
# DIARIZE_THREADS=3                       # CPU threads for the speaker step (set low on a shared server)
# DIARIZE_SHIFT=0.5                       # fast backend: 0.1 = most accurate and slowest, 0.5 = default
# HF_TOKEN=your_huggingface_token_here    # only for DIARIZER=pyannote
